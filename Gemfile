source 'https://rubygems.org'

# No `ruby` pin here on purpose: Appraisal copies this Gemfile's directives into
# every generated gemfiles/*.gemfile, and those run across a Ruby matrix (2.7 for
# Jekyll 3.0–3.7, 3.3 for Jekyll 3.8+). See .circleci/config.yml and Appraisals.
gem 'jekyll', '~> 3.8.0'
gem 'rexml'
gem 'appraisal', '~> 2.5.0'

gem 'pry'
gem 'rspec', '~> 3.13.0'
gem 'nokogiri'

